# train.py
import os
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader
import argparse
from dataset import MelDataset
from model_baseline_B import LSTMSpectrogramClassifier
import numpy as np
from sklearn.metrics import accuracy_score
import pandas as pd
from tqdm import tqdm

def train_epoch(model, dataloader, criterion, optimizer, device):
    model.train()
    losses = []
    all_preds = []
    all_labels = []
    for x_batch, y_batch in tqdm(dataloader, desc='train', leave=False):
        x_batch = torch.tensor(x_batch, dtype=torch.float32).to(device)  # (b, seq, n_mels)
        y_batch = torch.tensor(y_batch, dtype=torch.long).to(device)
        optimizer.zero_grad()
        logits = model(x_batch)
        loss = criterion(logits, y_batch)
        loss.backward()
        optimizer.step()
        losses.append(loss.item())
        preds = logits.argmax(dim=1).cpu().numpy()
        all_preds.extend(preds.tolist())
        all_labels.extend(y_batch.cpu().numpy().tolist())
    acc = accuracy_score(all_labels, all_preds)
    return np.mean(losses), acc

def eval_epoch(model, dataloader, criterion, device):
    model.eval()
    losses = []
    all_preds = []
    all_labels = []
    with torch.no_grad():
        for x_batch, y_batch in tqdm(dataloader, desc='eval', leave=False):
            x_batch = torch.tensor(x_batch, dtype=torch.float32).to(device)
            y_batch = torch.tensor(y_batch, dtype=torch.long).to(device)
            logits = model(x_batch)
            loss = criterion(logits, y_batch)
            losses.append(loss.item())
            preds = logits.argmax(dim=1).cpu().numpy()
            all_preds.extend(preds.tolist())
            all_labels.extend(y_batch.cpu().numpy().tolist())
    acc = accuracy_score(all_labels, all_preds)
    return np.mean(losses), acc

def main(args):
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    # Datasets
    train_ds = MelDataset(args.train_processed)
    val_ds = MelDataset(args.val_processed)
    train_loader = DataLoader(train_ds, batch_size=args.batch_size, shuffle=True, num_workers=4)
    val_loader = DataLoader(val_ds, batch_size=args.batch_size, shuffle=False, num_workers=4)
    # model
    model = LSTMSpectrogramClassifier(n_mels=args.n_mels, hidden_size=args.hidden_size, num_layers=args.num_layers, num_classes=args.num_classes, dropout=args.dropout, bidirectional=not args.unidirectional)
    model.to(device)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=args.lr)
    best_val_acc = 0.0
    history = []
    for epoch in range(1, args.epochs+1):
        train_loss, train_acc = train_epoch(model, train_loader, criterion, optimizer, device)
        val_loss, val_acc = eval_epoch(model, val_loader, criterion, device)
        print(f"Epoch {epoch}: train_loss={train_loss:.4f} train_acc={train_acc:.4f} val_loss={val_loss:.4f} val_acc={val_acc:.4f}")
        history.append({'epoch':epoch,'train_loss':train_loss,'train_acc':train_acc,'val_loss':val_loss,'val_acc':val_acc})
        # save best
        if val_acc > best_val_acc:
            best_val_acc = val_acc
            ckpt = {'model_state': model.state_dict(), 'optimizer_state': optimizer.state_dict(), 'epoch': epoch}
            os.makedirs(args.checkpoint_dir, exist_ok=True)
            torch.save(ckpt, os.path.join(args.checkpoint_dir, 'best_model.pth'))
    # save history
    import pandas as pd
    pd.DataFrame(history).to_csv(os.path.join(args.checkpoint_dir, 'training_history.csv'), index=False)
    print('Training completed. Best val acc:', best_val_acc)

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--train_processed', default='processed/train', type=str)
    parser.add_argument('--val_processed', default='processed/val', type=str)
    parser.add_argument('--checkpoint_dir', default='checkpoints', type=str)
    parser.add_argument('--n_mels', default=64, type=int)
    parser.add_argument('--hidden_size', default=128, type=int)
    parser.add_argument('--num_layers', default=2, type=int)
    parser.add_argument('--num_classes', default=5, type=int)
    parser.add_argument('--dropout', default=0.3, type=float)
    parser.add_argument('--unidirectional', action='store_true')
    parser.add_argument('--lr', default=1e-3, type=float)
    parser.add_argument('--batch_size', default=32, type=int)
    parser.add_argument('--epochs', default=50, type=int)
    args = parser.parse_args()
    main(args)
